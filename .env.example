# Supabase credentials
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_CONNECTION_URL=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SITE_URL=

# Templates API
NEXT_PUBLIC_TEMPLATE_API_URL=
TEMPLATE_API_URL=
TEMPLATE_UPLOAD_API_KEY=

# Secret key for signing page auth cookies (can be generated using `openssl rand -hex 32`)
PAGE_AUTH_SECRET=

# Google Fonts API Key (only to used to execute `npm run fonts:update`)
GOOGLE_FONTS_API_KEY=

# Flutterwave billing
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
NEXT_PUBLIC_QAY_BILLING_CURRENCY=USD
QAY_STARTER_PRICE=9
QAY_PRO_PRICE=19
QAY_STUDIO_PRICE=49
QAY_AGENCY_PRICE=99

# QAY AI Builder
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# QAY custom domains on Vercel
# Required for one-click domain attachment after upgrading the Vercel project plan.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
NEXT_PUBLIC_QAY_BASE_DOMAIN=
QAY_URL_MODE=path

# Hidden QAY owner access
# Press Ctrl+Alt+Shift+Q in the dashboard to reveal the unlock input.
QAY_ADMIN_EMAILS=
QAY_ADMIN_ACCESS_PASSWORD=
QAY_ADMIN_ACCESS_SECRET=
