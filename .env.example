# Supabase credentials
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_CONNECTION_URL=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SITE_URL=

# Templates API
NEXT_PUBLIC_TEMPLATE_API_URL=
TEMPLATE_API_URL=
TEMPLATE_UPLOAD_API_KEY=

# Secret key for signing page auth cookies (can be generated using `openssl rand -hex 32`)
PAGE_AUTH_SECRET=

# Google Fonts API Key (only to used to execute `npm run fonts:update`)
GOOGLE_FONTS_API_KEY=

# Flutterwave billing
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Lemon Squeezy billing
# If configured, QAY uses Lemon Squeezy checkout before falling back to Flutterwave.
# Keep QAY_BILLING_TEST_MODE=true while testing. Set it to false only when live billing is ready.
QAY_BILLING_TEST_MODE=true
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STARTER_VARIANT_ID=
LEMON_SQUEEZY_PRO_VARIANT_ID=

NEXT_PUBLIC_QAY_BILLING_CURRENCY=USD
QAY_STARTER_PRICE=19
QAY_PRO_PRICE=30

# QAY AI Builder
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
QAY_AI_HTML_PROVIDER_TIMEOUT_MS=30000
QAY_AI_ALLOW_LOCAL_FALLBACK=false

# QAY custom domains on Vercel
# Required for one-click domain attachment after upgrading the Vercel project plan.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
NEXT_PUBLIC_QAY_BASE_DOMAIN=
QAY_URL_MODE=path

# QAY per-site visitor auth emails
# Falls back to QAY_INVITE_* or SMTP_* if these are blank.
QAY_SITE_AUTH_SMTP_HOST=
QAY_SITE_AUTH_SMTP_PORT=587
QAY_SITE_AUTH_SMTP_USER=
QAY_SITE_AUTH_SMTP_PASSWORD=
QAY_SITE_AUTH_FROM_EMAIL=
QAY_SITE_AUTH_FROM_NAME=QAY

# QAY commerce (Medusa)
# Required from the Medusa project:
# - MEDUSA_BACKEND_URL: your Medusa backend API URL, for example http://localhost:9000
# - MEDUSA_PUBLISHABLE_KEY: the publishable API key from Medusa Admin/settings
# NEXT_PUBLIC_MEDUSA_BACKEND_URL is optional for browser-side UI; keep it the same as MEDUSA_BACKEND_URL when local.
MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=

# Optional from Medusa.
# Leave these blank first. Add them only if product fetching needs a specific region or sales channel.
MEDUSA_REGION_ID=
MEDUSA_SALES_CHANNEL_ID=

# Optional notes only. QAY does not need these to fetch products.
MEDUSA_ADMIN_URL=
MEDUSA_STOREFRONT_URL=

# Hidden QAY owner access
# Press Ctrl+Alt+Shift+Q in the dashboard to reveal the unlock input.
QAY_ADMIN_EMAILS=
QAY_ADMIN_ACCESS_PASSWORD=
QAY_ADMIN_ACCESS_SECRET=
