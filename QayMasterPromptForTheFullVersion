export async function callWithFallback(
  prompt: string,
  system: string
): Promise<string> {
  const available = PROVIDERS.filter(p => p.available())

  for (const provider of available) {
    try {
      console.log(`[AI] Trying ${provider.name}...`)
      const result = await provider.call(prompt, system)
      console.log(`[AI] Success with ${provider.name}`)
      return result
    } catch (err: any) {
      // Rate limit or quota error → try next
      if (
        err.status === 429 ||
        err.status === 503 ||
        err.message?.includes('rate') ||
        err.message?.includes('quota') ||
        err.message?.includes('overloaded')
      ) {
        console.warn(`[AI] ${provider.name} failed: ${err.message}. Trying next...`)
        continue
      }
      // Other errors → throw immediately
      throw err
    }
  }

  throw new Error('All AI providers failed or are rate limited')
}

